<log4net>
	<appender name="DebuggerAppender" type="log4net.Appender.DebugAppender">
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%5level [%.10class] - %message%newline" />
			<!--<conversionPattern value="%newline%file (%line): %level: %message%newline"/>-->
		</layout>
		<filter type="log4net.Filter.LevelRangeFilter">
			<levelMin value="DEBUG" />
			<levelMax value="FATAL" />
		</filter>
	</appender>

	<!-- Plain, not ManagedColored: colouring is a Win32 console call per line, and every
	     server here runs redirected to a file, where that work is discarded. -->
	<appender name="Console" type="log4net.Appender.ConsoleAppender">
		<layout type="log4net.Layout.PatternLayout">
			<!-- Pattern to output the caller's file name and line number -->
			<!--<conversionPattern value="%5level [%thread] (%file:%line) - %message%newline" />-->
			<conversionPattern value="%5level [%logger{1}] - %message%newline" />
		</layout>

		<filter type="log4net.Filter.LoggerMatchFilter">
			<loggerToMatch value="MiNET.Client" />
			<acceptOnMatch value="false" />
		</filter>

		<filter type="log4net.Filter.LoggerMatchFilter">
			<loggerToMatch value="MiNET.Net.ConnectionInfo" />
			<acceptOnMatch value="false" />
		</filter>

		<filter type="log4net.Filter.LoggerMatchFilter">
			<loggerToMatch value="MiNET.LevelDB" />
			<acceptOnMatch value="false" />
		</filter>

		<filter type="log4net.Filter.LevelRangeFilter">
			<levelMin value="TRACE" />
			<levelMax value="FATAL" />
		</filter>

	</appender>

	<appender name="RollingFile" type="log4net.Appender.RollingFileAppender">
		<file value="minetlog.log" />
		<appendToFile value="true" />
		<!-- Default is true: a flush to disk per event, taken on the logging thread inside the
		     appender lock. That is what starves the 50ms world tick. -->
		<immediateFlush value="false" />
		<maximumFileSize value="50000KB" />
		<maxSizeRollBackups value="2" />

		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
		</layout>

		<filter type="log4net.Filter.LoggerMatchFilter">
			<loggerToMatch value="MiNET.LevelDB" />
			<acceptOnMatch value="false" />
		</filter>

		<filter type="log4net.Filter.LoggerMatchFilter">
			<loggerToMatch value="MiNET.Client.ClientUtils" />
			<acceptOnMatch value="true" />
		</filter>

		<filter type="log4net.Filter.LoggerMatchFilter">
			<loggerToMatch value="MiNET.Client" />
			<acceptOnMatch value="false" />
		</filter>
		<filter type="log4net.Filter.LoggerMatchFilter">
			<loggerToMatch value="MiNET.Net.McpeAvailableCommands" />
			<acceptOnMatch value="false" />
		</filter>

		<!--<filter type="log4net.Filter.LoggerMatchFilter">
			<loggerToMatch value="MiNET.Net.ConnectionInfo" />
			<acceptOnMatch value="false" />
		</filter>-->

		<filter type="log4net.Filter.LevelRangeFilter">
			<levelMin value="VERBOSE" />
			<levelMax value="FATAL" />
		</filter>

	</appender>

	<!-- Trace session (protocol 2192): the parse loop's per-frame decode failure (hex dump +
	     exception) is Debug-gated; this surfaces it for exactly one logger. Remove when the
	     2192 decode defects are closed. -->
	<logger name="MiNET.Net.BedrockMessageHandlerBase">
		<level value="DEBUG" />
	</logger>

	<root>
		<!-- INFO is the floor for anything measured. TRACE/VERBOSE puts ~29k events a second
		     through two serialized appenders, which blocks threads at almost no CPU cost and
		     dominates every reading taken through it. Raise it only for a deliberate trace
		     session, never for a load or performance run. -->
		<level value="INFO" />
		<appender-ref ref="Console" />
		<appender-ref ref="RollingFile" />
		<!--<appender-ref ref="DebuggerAppender"/>-->
	</root>
</log4net>