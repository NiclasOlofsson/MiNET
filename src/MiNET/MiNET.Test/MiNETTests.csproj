<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="Current">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="MSTest" Version="4.3.3" />
    <PackageReference Include="SIPSorcery" Version="10.0.13" />
    <PackageReference Include="System.CodeDom" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MiNET.BdsExtract\MiNET.BdsExtract.csproj" />
    <ProjectReference Include="..\MiNET.Client\MiNET.Client.csproj" />
    <ProjectReference Include="..\MiNET.Parking\MiNET.Parking.csproj" />
    <ProjectReference Include="..\MiNET\MiNET.csproj" />
    <ProjectReference Include="..\TestPlugin\TestPlugin.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="geometry.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\chunks\*.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The BDS frames MiNET.BlockGen generates the item registry and creative catalog against.
         Linked rather than copied, so the generator and the test measure the same bytes. -->
    <None Include="..\MiNET.BlockGen\Captures\*.bin" Link="Data\registry\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- The frame readers, linked for the same reason the frames are: the generator and the tests
         read the captures with one piece of code. A project reference would pull in the generator's
         linked copy of BlockDefinition.cs and collide with MiNET's own. -->
    <Compile Include="..\MiNET.BlockGen\Captures.cs" Link="Data\registry\Captures.cs" />
  </ItemGroup>
</Project>